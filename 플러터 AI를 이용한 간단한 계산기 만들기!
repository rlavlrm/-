import 'package:flutter/material.dart';

void main() => runApp(const CalculatorApp());

class CalculatorApp extends StatefulWidget {
  const CalculatorApp({super.key});

  @override
  State createState() => _CalculatorAppState();
}

class _CalculatorAppState extends State {
  bool _isDarkMode = true;
  String _expression = '';
  String _result = '';

  void _onPressed(String txt) {
    setState(() {
      if (txt == 'C') {
        _expression = '';
        _result = '';
      } else if (txt == 'CE') {
        if (_expression.isNotEmpty) {
          int lastOpIndex = _expression.lastIndexOf(RegExp(r'[+\-×÷%]'));
          if (lastOpIndex != -1) {
            _expression = _expression.substring(0, lastOpIndex + 1);
          } else {
            _expression = '';
          }
        }
      } else if (txt == '⌫') {
        if (_expression.isNotEmpty) {
          _expression = _expression.substring(0, _expression.length - 1);
        }
      } else if (txt == '+/-') {
        if (_expression.isNotEmpty) {
          if (_expression.startsWith('-')) {
            _expression = _expression.substring(1);
          } else {
            _expression = '-$_expression';
          }
        }
      } else if (txt == '=') {
        if (_expression.isNotEmpty) {
          _calculateResult();
        }
      } else {
        _expression += txt;
      }
    });
  }

  void _calculateResult() {
    try {
      String parsed = _expression.replaceAll('×', '*').replaceAll('÷', '/').replaceAll('%', '/100');
      List tokens = [];
      String currentNum = '';
      
      for (int i = 0; i < parsed.length; i++) {
        String char = parsed[i];
        if (['+', '-', '*', '/'].contains(char)) {
          if (currentNum.isNotEmpty) {
            tokens.add(currentNum);
            currentNum = '';
          }
          tokens.add(char);
        } else {
          currentNum += char;
        }
      }
      if (currentNum.isNotEmpty) tokens.add(currentNum);

      if (tokens.isEmpty) return;

      double total = double.parse(tokens[0]);
      for (int i = 1; i < tokens.length - 1; i += 2) {
        String op = tokens[i];
        double nextNum = double.parse(tokens[i + 1]);
        if (op == '+') total += nextNum;
        if (op == '-') total -= nextNum;
        if (op == '*') total *= nextNum;
        if (op == '/') total = nextNum != 0 ? total / nextNum : 0;
      }

      _result = total % 1 == 0 ? total.toInt().toString() : total.toString();
    } catch (e) {
      _result = 'Error';
    }
  }

  @override
  Widget build(BuildContext context) {
    final bgColor = _isDarkMode ? Colors.black : Colors.white;
    final textColor = _isDarkMode ? Colors.white : Colors.black;
    
    final numBtnBg = _isDarkMode ? Colors.grey[900]! : Colors.grey[200]!;
    final numBtnText = textColor;

    final opBtnBg = _isDarkMode ? Colors.white : Colors.black;
    final opBtnText = _isDarkMode ? Colors.black : Colors.white;

    // 요청하신 위치 조건에 완벽히 맞춘 키패드 데이터
    final keyLayout = [
      ['C', 'CE', '%', '⌫'],       // C 맨 왼쪽, 백스페이스 맨 오른쪽
      ['7', '8', '9', '÷'],
      ['4', '5', '6', '×'],
      ['1', '2', '3', '-'],
      ['.', '0', '+/-', '+'],       // 0은 2 아래, +/-는 3 아래 위치
    ];

    return MaterialApp(
      debugShowCheckedModeBanner: false,
      home: Scaffold(
        backgroundColor: bgColor,
        appBar: AppBar(
          backgroundColor: bgColor,
          elevation: 0,
          actions: [
            IconButton(
              icon: Icon(
                _isDarkMode ? Icons.wb_sunny : Icons.nightlight_round,
                color: textColor,
              ),
              onPressed: () => setState(() => _isDarkMode = !_isDarkMode),
            ),
          ],
        ),
        body: SafeArea(
          child: Column(
            children: [
              // 1. 수식/결과 출력 영역
              Expanded(
                child: Container(
                  alignment: Alignment.bottomRight,
                  padding: const EdgeInsets.all(24),
                  child: SingleChildScrollView(
                    reverse: true,
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.end,
                      mainAxisAlignment: MainAxisAlignment.end,
                      children: [
                        Text(
                          _expression.isEmpty ? '0' : _expression,
                          style: TextStyle(
                            fontSize: 36,
                            color: textColor,
                            fontWeight: FontWeight.w400,
                          ),
                        ),
                        if (_result.isNotEmpty) ...[
                          const SizedBox(height: 12),
                          Text(
                            '= $_result',
                            style: TextStyle(
                              fontSize: 44,
                              color: textColor,
                              fontWeight: FontWeight.bold,
                            ),
                          ),
                        ],
                      ],
                    ),
                  ),
                ),
              ),
              const Divider(height: 1),
              const SizedBox(height: 8),
              
              // 2. 키패드 영역
              ...keyLayout.map((row) => Row(
                children: row.map((btnTxt) {
                  bool isOp = ['+', '-', '×', '÷', '%', 'C', 'CE', '⌫', '+/-'].contains(btnTxt);
                  return Expanded(
                    child: Padding(
                      padding: const EdgeInsets.all(4.0),
                      child: ElevatedButton(
                        style: ElevatedButton.styleFrom(
                          backgroundColor: isOp ? opBtnBg : numBtnBg,
                          elevation: 0,
                          padding: const EdgeInsets.symmetric(vertical: 16),
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(16),
                          ),
                        ),
                        onPressed: () => _onPressed(btnTxt),
                        child: Text(
                          btnTxt,
                          style: TextStyle(
                            fontSize: 20,
                            fontWeight: FontWeight.bold,
                            color: isOp ? opBtnText : numBtnText,
                          ),
                        ),
                      ),
                    ),
                  );
                }).toList(),
              )),

              // 3. 맨 밑 하단 독채 = 버튼
              Padding(
                padding: const EdgeInsets.symmetric(horizontal: 4.0, vertical: 4.0),
                child: SizedBox(
                  width: double.infinity,
                  child: ElevatedButton(
                    style: ElevatedButton.styleFrom(
                      backgroundColor: opBtnBg,
                      elevation: 0,
                      padding: const EdgeInsets.symmetric(vertical: 16),
                      shape: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(16),
                      ),
                    ),
                    onPressed: () => _onPressed('='),
                    child: Text(
                      '=',
                      style: TextStyle(
                        fontSize: 26,
                        fontWeight: FontWeight.bold,
                        color: opBtnText,
                      ),
                    ),
                  ),
                ),
              ),
              const SizedBox(height: 8),
            ],
          ),
        ),
      ),
    );
  }
}
